# Supabase — from `npx supabase status` after `npx supabase start`
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=   # "Publishable" key (formerly anon) from supabase status
SUPABASE_SECRET_KEY=                    # "Secret" key (formerly service_role) from supabase status

# Prisma — Supabase local PostgreSQL
# Session pooler (port 5432) — general queries
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
# Direct connection — migrations / DDL
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Payment gateway webhook signature key (choose any secret string for local dev)
GATEWAY_X_SIGNATURE_KEY=local_gateway_secret
