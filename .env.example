# Supabase — from `npx supabase status` after `npx supabase start`
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# "Publishable" key from `npx supabase status` (formerly anon key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy alias — same value, kept for Supabase JS v1 compatibility
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "Secret" key from `npx supabase status` (formerly service_role key)
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Prisma — Supabase local PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Payment gateway webhook signature key (any secret string for local dev)
GATEWAY_X_SIGNATURE_KEY=local_gateway_secret
