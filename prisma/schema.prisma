generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id   String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name String

  memberships       Membership[]
  units             Unit[]
  tenants           Tenant[]
  leases            Lease[]
  invoices          Invoice[]
  payments          Payment[]
  paymentAllocations PaymentAllocation[]
  gatewayBills      GatewayBill[]
  auditLog          AuditLog[]

  @@map("organizations")
}

model Membership {
  id     String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId String @db.Uuid @map("user_id")
  orgId  String @db.Uuid @map("org_id")
  role   String

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@map("memberships")
}

model Unit {
  id    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId String @db.Uuid @map("org_id")
  name  String

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leases Lease[]

  @@map("units")
}

model Tenant {
  id       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId    String  @db.Uuid @map("org_id")
  userId   String? @db.Uuid @map("user_id")
  fullName String  @map("full_name")
  email    String
  phone    String  @default("")

  org    Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  leases Lease[]

  @@map("tenants")
}

model Lease {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String @db.Uuid @map("org_id")
  unitId         String @db.Uuid @map("unit_id")
  tenantId       String @db.Uuid @map("tenant_id")
  startDate      DateTime @map("start_date") @db.Date
  endDate        DateTime @map("end_date") @db.Date
  monthlyRentSen BigInt @map("monthly_rent_sen")
  depositSen     BigInt @map("deposit_sen")

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  unit     Unit         @relation(fields: [unitId], references: [id])
  tenant   Tenant       @relation(fields: [tenantId], references: [id])
  invoices Invoice[]
  payments Payment[]
  gatewayBills GatewayBill[]

  @@map("leases")
}

model Invoice {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId       String   @db.Uuid @map("org_id")
  leaseId     String   @db.Uuid @map("lease_id")
  kind        String
  periodIndex Int?     @map("period_index")
  periodStart DateTime? @map("period_start") @db.Date
  periodEnd   DateTime? @map("period_end") @db.Date
  dueDate     DateTime @map("due_date") @db.Date
  amountSen   BigInt   @map("amount_sen")

  org         Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lease       Lease               @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  allocations PaymentAllocation[]

  @@map("invoices")
}

model Payment {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId          String   @db.Uuid @map("org_id")
  leaseId        String   @db.Uuid @map("lease_id")
  amountSen      BigInt   @map("amount_sen")
  unappliedSen   BigInt   @default(0) @map("unapplied_sen")
  method         String
  status         String   @default("pending_verification")
  receivedAt     DateTime @map("received_at") @db.Timestamptz
  slipPath       String?  @map("slip_path")
  gatewayBillId  String?  @db.Uuid @map("gateway_bill_id")
  rejectionReason String? @map("rejection_reason")
  voidReason     String?  @map("void_reason")
  recordedBy     String?  @db.Uuid @map("recorded_by")

  org         Organization        @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lease       Lease               @relation(fields: [leaseId], references: [id], onDelete: Cascade)
  allocations PaymentAllocation[]

  @@map("payments")
}

model PaymentAllocation {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String @db.Uuid @map("org_id")
  paymentId String @db.Uuid @map("payment_id")
  invoiceId String @db.Uuid @map("invoice_id")
  amountSen BigInt @map("amount_sen")

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  payment Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoice Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("payment_allocations")
}

model GatewayBill {
  id        String @id @db.Uuid
  orgId     String @db.Uuid @map("org_id")
  leaseId   String @db.Uuid @map("lease_id")
  amountSen BigInt @map("amount_sen")
  status    String @default("pending")

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  lease Lease        @relation(fields: [leaseId], references: [id], onDelete: Cascade)

  @@map("gateway_bills")
}

model AuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String   @db.Uuid @map("org_id")
  actorId   String?  @db.Uuid @map("actor_id")
  action    String
  entityId  String?  @db.Uuid @map("entity_id")
  details   Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("audit_log")
}
